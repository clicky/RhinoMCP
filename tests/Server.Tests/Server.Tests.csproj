<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Rhino.AI.Server.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.3.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <!--
    Pull only the pure (non-Rhino, non-AspNetCore) Server sources into the test
    assembly. McpEndpoint.cs depends on Microsoft.AspNetCore and ToolRegistry.cs
    depends on RhinoApp; those need a different host to test and live elsewhere.
    Compiling the sources in (rather than ProjectReference'ing RhinoAI.csproj)
    keeps the test assembly RhinoCommon-free and side-steps internals-visibility.
  -->
  <ItemGroup>
    <Compile Include="../../rhino/plugin/Server/Attributes.ai.cs" LinkBase="ServerSources" />
    <Compile Include="../../rhino/plugin/Server/Protocol.ai.cs" LinkBase="ServerSources" />
    <Compile Include="../../rhino/plugin/Server/SchemaBuilder.ai.cs" LinkBase="ServerSources" />
    <Compile Include="../../rhino/plugin/Server/ParameterBinder.ai.cs" LinkBase="ServerSources" />
    <Compile Include="../../rhino/plugin/Server/BindNotes.ai.cs" LinkBase="ServerSources" />
    <Compile Include="../../rhino/plugin/Server/BindingFailure.cs" LinkBase="ServerSources" />
    <Compile Include="../../rhino/plugin/Server/ResourceRegistry.ai.cs" LinkBase="ServerSources" />
    <Compile Include="../../rhino/plugin/Server/ToolResultFormatter.ai.cs" LinkBase="ServerSources" />
  </ItemGroup>

  <!-- IToolResult is the contract every tool returns and the formatter renders; both are Rhino-free. -->
  <ItemGroup>
    <Compile Include="../../rhino/plugin/Tools/ToolResult.cs" LinkBase="PluginSources" />
    <Using Include="System.Text.Json" />
    <Using Include="Rhino.AI.Server" />
  </ItemGroup>

  <!-- The panel feed and the transcript graph it flattens: no Rhino, so they test here. -->
  <ItemGroup>
    <Compile Include="../../rhino/plugin/Agents/Conversation.ai.cs" LinkBase="PanelSources" />
    <Compile Include="../../rhino/plugin/Agents/ConversationDto.ai.cs" LinkBase="PanelSources" />
    <Compile Include="../../rhino/plugin/Agents/TokenUsage.ai.cs" LinkBase="PanelSources" />
    <Compile Include="../../rhino/plugin/UI/ToolSummary.cs" LinkBase="PanelSources" />
    <Compile Include="../../rhino/plugin/WebPanel/PanelEvents.ai.cs" LinkBase="PanelSources" />
    <Compile Include="../../rhino/plugin/WebPanel/ToolChips.ai.cs" LinkBase="PanelSources" />
    <Compile Include="../../rhino/plugin/WebPanel/ConversationFeed.ai.cs" LinkBase="PanelSources" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../rhino/plugin/McpConfigEdit.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/ScriptProjects/PluginNaming.cs" LinkBase="PluginSources" />
    <!-- ask_user's question item: the schema generated from it is what the agent reads, so assert
         the real record rather than a lookalike. -->
    <Compile Include="../../rhino/plugin/Tools/QuestionSpec.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Tools/AskUserValidation.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Tools/AskUserQuestion.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Tools/Coercions.cs" LinkBase="PluginSources" />
  </ItemGroup>

</Project>
