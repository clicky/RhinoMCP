<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Rhino.AI.StreamJson.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../rhino/acp/Acp.csproj" />
  </ItemGroup>

  <!--
    Compile the agent layer's PURE sources straight into the test assembly (mirrors
    Server.Tests pulling in Protocol.cs). That keeps the assembly RhinoCommon- and
    AspNetCore-free and side-steps internals-visibility. The two RhinoCommon touch points
    in this closure (RhinoApp.WriteLine and the AISettings/PersistentSettings persistence
    surface) plus RouterMcpConfig are satisfied by the tiny headless shims in Shims.cs, so
    the code under test runs unchanged.
  -->
  <ItemGroup>
    <Compile Include="../../rhino/plugin/Server/Protocol.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Server/BindNotes.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/AgentAdapter.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/AgentDefinition.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/Registry/AgentRegistry.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/Registry/IAgentFinder.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/Registry/ClaudeFinder.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/Registry/CodexFinder.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/Registry/GeminiFinder.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/AgentPrompts.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/Attachment.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/UserMessage.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/AcpMessageMapper.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/CliProcess.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/CliLogin.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/IStreamJsonParser.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/ParsedLine.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/TokenUsage.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/ClaudeStreamJsonParser.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/CodexStreamJsonParser.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/StreamJsonAgent.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/IAgentRunner.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/AgentRunner.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/RhinoAcpClient.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/Conversation.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/ConversationDto.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Agents/ConversationStore.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Tools/AskUserQuestion.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/Tools/QuestionReply.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/UI/ToolSummary.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/WebPanel/PanelEvents.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/WebPanel/PanelCommands.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/WebPanel/PanelJson.ai.cs" LinkBase="PluginSources" />
    <Compile Include="../../rhino/plugin/WebPanel/PanelTheme.ai.cs" LinkBase="PluginSources" />
