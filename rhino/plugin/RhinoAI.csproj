<Project Sdk="Microsoft.NET.Sdk">

  <!-- The standard Rhino C# plug-in property sheet: .rhp TargetExt, the build-type
       DefineConstants (RHINO_WIP_BUILD / _BETA_ / _COMMERCIAL_) and, via
       Rhino.Common.props, $(RhinoSrcDir) / $(RhinoOutputDir).
       Skipped in a standalone checkout, which has no Rhino source tree. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\..\..\RhinoProjectPropertySheets\Rhino.CS.PlugIn.props" Condition="'$(IsInRhino)' == 'true'" />

  <PropertyGroup>
    <!-- Rhino 9: net8.0. In-tree there is only one Rhino to build against, so R8 is
         a standalone-checkout option only. -->
    <RhinoTarget Condition="'$(IsInRhino)' == 'true'">R9</RhinoTarget>
    <RhinoTarget Condition="'$(RhinoTarget)' == ''">R9</RhinoTarget>
    <!-- R8/R9 source gates (#if R9) follow $(RhinoTarget) directly. -->
    <DefineConstants>$(DefineConstants);$(RhinoTarget)</DefineConstants>
    <PluginOS Condition="'$(PluginOS)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">win</PluginOS>
    <PluginOS Condition="'$(PluginOS)' == ''">osx</PluginOS>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <!-- CA1416: System.Drawing and friends are Windows-only, and this stays a plain
         net8.0 plug-in (the .rhp has to sit in a folder literally named net8.0 for
         RhinoCommon's GetMultiTargetPath to find it, so net8.0-windows is not an option).
         NU1701/NU1702: the Grasshopper package's assets predate net8.0.
         MSB3277: the usual framework-assembly version spread across the Rhino SDK
         project references, plus the in-tree RhinoCommon vs the packaged Grasshopper's
         older RhinoCommon. CS0436: version.cs is compiled into this plug-in and into
         several of the assemblies it references, whose InternalsVisibleTo can leak
         their RhinoBuildConstants here - harmless, the constants are identical, but
         Rhino.Common.props turns warnings into errors in Rhino.sln Release builds. -->
    <NoWarn>$(NoWarn);CA1416;NU1701;NU1702;MSB3277;CS0436</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RhinoAI</RootNamespace>
    <AssemblyName>RhinoAI</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- In-tree R9 builds stage into the solution's shared plug-in folder,
         src4/bin/<Config>/Plug-ins/RhinoAI (bin/<Config>MacRhino/... on macOS), so
         a locally built Rhino loads this plug-in like every other plug-in in
         Rhino.sln / RhinoMacBuild.sln. The layout inside that folder is unchanged
         (net8.0/ + router/ + manifest.yml + icon.png), so the yak package is still
         built straight out of it, and RhinoCommon's GetMultiTargetPath resolves the
         net8.0/ subfolder on both platforms. R8, and a checkout without the property
         sheets, keep the project-local bin.

         NormalizePath is load-bearing: $(RhinoOutputDir) is spelt with backslashes,
         which macOS treats as ordinary filename characters. The router publish below
         hands this path to a shell, so it has to be real separators. -->
    <RhinoAIStagingDir Condition="'$(RhinoTarget)' == 'R9' AND '$(RhinoOutputDir)' != ''">$([MSBuild]::NormalizePath('$(RhinoOutputDir)', 'Plug-ins', 'RhinoAI'))</RhinoAIStagingDir>
    <RhinoAIStagingDir Condition="'$(RhinoAIStagingDir)' == ''">$(MSBuildProjectDirectory)/bin/$(RhinoTarget)-$(PluginOS)/$(Configuration)</RhinoAIStagingDir>
    <!-- $(TargetFramework) is appended by the SDK, giving <staging>/net8.0. -->
    <OutputPath>$(RhinoAIStagingDir)/</OutputPath>
    <YakStagingDir>$(RhinoAIStagingDir)</YakStagingDir>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Assembly version attributes come from src4/version.cs (in-tree) or from
         $(Version) in rhino/Directory.Build.props (standalone); $(Company) likewise.
         Do not set them here. -->
    <Title>Rhino AI</Title>
    <Description>AI tools for Rhino</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="../acp/Acp.csproj" />
    <!-- Link (not copy) the router's on-disk path contract so the plugin and
         router share one definition of the listeners drop dir. Separate
         assemblies, single source file: the consts cannot drift. -->
    <Compile Include="../router/RouterPaths.cs" Link="RouterPaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../art/logo.svg" LogicalName="RhinoAI.logo.svg" />
    <EmbeddedResource Include="../../art/copy.svg" LogicalName="RhinoAI.copy.svg" />
    <EmbeddedResource Include="../../art/paperclip.svg" LogicalName="RhinoAI.paperclip.svg" />
    <!-- The web panel, built from rhino/panel. Committed so a build needs no Node toolchain; the
         RebuildAIPanel target below refreshes it when one is present. -->
    <EmbeddedResource Include="../panel/dist/panel.host.html" LogicalName="RhinoAI.panel.html" />
  </ItemGroup>

  <!-- Best effort: rebuild the panel bundle when the developer has already run `npm install` in
       rhino/panel. ContinueOnError means a machine without Node simply embeds the committed file. -->
  <Target Name="RebuildAIPanel" BeforeTargets="BeforeBuild"
          Condition="'$(SkipPanelBuild)' != 'true' AND Exists('$(MSBuildProjectDirectory)/../panel/node_modules/esbuild')">
    <Exec Command="node build.mjs" WorkingDirectory="$(MSBuildProjectDirectory)/../panel" ContinueOnError="true" />
  </Target>

  <PropertyGroup>
    <AspNetCoreRuntimeVersion>8.0.30</AspNetCoreRuntimeVersion>
  </PropertyGroup>

  <!-- Restored only to source the files BundleAspNetCoreFramework copies, so they are
       needed only where that target runs (see it below). -->
  <ItemGroup Condition="'$(IsInRhino)' == 'false'">
    <PackageReference Include="Microsoft.AspNetCore.App.Runtime.win-x64" Version="$(AspNetCoreRuntimeVersion)" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" Condition="'$(PluginOS)' == 'win'" />
    <PackageReference Include="Microsoft.AspNetCore.App.Runtime.osx-arm64" Version="$(AspNetCoreRuntimeVersion)" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" Condition="'$(PluginOS)' == 'osx'" />
  </ItemGroup>

  <!-- In-tree: the Rhino SDK assemblies come from the projects they are built from,
       so this plug-in always compiles against the RhinoCommon sitting next to it -
       the same references Commands, MeshCommands and the Grasshopper components use.
       ExcludeAssets/Private=False because Rhino already ships all of these; only
       RhinoAI's own output belongs in the plug-in folder. -->
  <ItemGroup Condition="'$(IsInRhino)' == 'true'">
    <ProjectReference Include="$(RhinoSrcDir)\DotNetSDK\rhinocommon\dotnet\RhinoCommon.csproj" Private="False" ExcludeAssets="all" />
    <ProjectReference Include="$(RhinoSrcDir)\DotNetSDK\Rhino.UI\Rhino.UI.csproj" Private="False" ExcludeAssets="all" />
    <ProjectReference Include="$(RhinoSrcDir)\DotNetSDK\Eto\src\Eto\Eto.csproj" Private="False" ExcludeAssets="all" />
    <ProjectReference Include="$(RhinoSrcDir)\DotNetSDK\RhinoCode\src\Rhino.Runtime.Code\Rhino.Runtime.Code.csproj" Private="False" ExcludeAssets="all" />
    <ProjectReference Include="$(RhinoSrcDir)\rhino4\Plug-ins\grasshopper2\Grasshopper2\Grasshopper2.csproj" Private="False" ExcludeAssets="all" />
    <ProjectReference Include="$(RhinoSrcDir)\rhino4\Plug-ins\grasshopper2\GrasshopperIO\GrasshopperIO.csproj" Private="False" ExcludeAssets="all" />
  </ItemGroup>

  <!-- GH1 is the one Rhino SDK assembly with no in-tree net8.0 build on Windows:
       Grasshopper.vbproj is net48-only there, and referencing it from a net8.0 project
       drags Eto.Wpf and RhinoWindows in transitively, failing the build with NETSDK1136
       unless the whole plug-in retargets to net8.0-windows. Rhino's own net8.0 GH
       components (GhPython, ScriptLibrary) sidestep this by building net48 on Windows,
       which a net8.0-only .rhp cannot do. So GH1's compile-time surface keeps coming
       from the package in-tree as well; nothing from it is copied into the plug-in
       folder. Revisit if Grasshopper.vbproj ever gains a net8.0 Windows target. -->
  <ItemGroup Condition="'$(IsInRhino)' == 'true'">
    <PackageReference Include="Grasshopper" Version="9.0.26132.12305-wip" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- System.Drawing.Common is part of the SDK surface this plug-in compiles against
       (System.Drawing.Icon / Image / Bitmap on RhinoCommon and Eto APIs), but the
       project references above carry ExcludeAssets="all", so it no longer arrives
       transitively the way it did off the RhinoCommon package. Declared here for the
       same reason export_PDF declares it. ExcludeAssets="runtime" because Rhino already
       ships it in bin/<Config>/netcore next to RhinoCommon - matching RhinoCommon.csproj,
       Rhino.UI.csproj and Grasshopper2 - so the plug-in does not load a second, older
       copy into its own AssemblyLoadContext. 8.0.0 is what $(DotNetSdkPackageVersion)
       in src4/Directory.Packages.props resolves to for the projects above; this project
       does not opt into central package management, so the version is spelt out. -->
  <ItemGroup Condition="'$(IsInRhino)' == 'true'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- Standalone checkout only. The referenced RhinoCommon version becomes the yak
       rh8_xx tag, so it is the minimum Rhino 8 service release Package Manager will
       offer this to. 8.19 is the floor: it is the first 8.x package with net7.0
       (.NET Core) assets, and everything below is net48-only. Its net7.0 targets add
       a WindowsForms FrameworkReference unconditionally (fixed in 8.27), which needs
       EnableWindowsTargeting off Windows. -->
  <PropertyGroup Condition="'$(IsInRhino)' == 'false' AND '$(RhinoTarget)' == 'R8' AND !$([MSBuild]::IsOSPlatform('Windows'))">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsInRhino)' == 'false' AND '$(RhinoTarget)' == 'R8'">
    <PackageReference Include="RhinoCommon" Version="8.19.25132.1001" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="8.19.25132.1001" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsInRhino)' == 'false' AND '$(RhinoTarget)' == 'R9'">
    <PackageReference Include="RhinoCommon" Version="9.0.26132.12305-wip" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="9.0.26132.12305-wip" />
    <PackageReference Include="Grasshopper2" Version="9.0.26132.12305-wip" />
    <PackageReference Include="RhinoCode" Version="9.0.26244.12303-beta" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(RhinoTarget)' == 'R8'">
    <Compile Remove="Tools/GH2/**/*.cs" />
    <Compile Remove="Resources/GH2/**/*.cs" />
  </ItemGroup>

  <!-- Rewrite the manifest's `version:` line from $(RhinoAIPackageVersion) so the yak
       manifest can never drift from the single source in Directory.Build.props. Runs as a
       build dependency (keeps the checked-in file in sync) and before the yak
       copy (so the staged package picks up the rewritten value). -->
  <UsingTask TaskName="SyncManifestVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestPath ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        string[] lines = System.IO.File.ReadAllLines(ManifestPath);
        bool changed = false;
        for (int i = 0; i < lines.Length; i++)
        {
            if (System.Text.RegularExpressions.Regex.IsMatch(lines[i], @"^\s*version\s*:"))
            {
                string updated = "version: " + Version;
                if (lines[i] != updated)
                {
                    lines[i] = updated;
                    changed = true;
                }
            }
        }
        if (changed)
        {
            System.IO.File.WriteAllLines(ManifestPath, lines);
            Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High,
                "[Rhino AI] Synced manifest.yml version to " + Version);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="SyncManifestVersion" BeforeTargets="Build;BuildYakPackage">
    <SyncManifestVersion ManifestPath="$(MSBuildProjectDirectory)/manifest.yml" Version="$(RhinoAIPackageVersion)" />
  </Target>

  <Target Name="BuildYakPackage" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/icon.png" DestinationFolder="$(YakStagingDir)/" SkipUnchangedFiles="true" />
    <PropertyGroup>
      <_Manifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/manifest.yml'))</_Manifest>
      <_Manifest>$([System.Text.RegularExpressions.Regex]::Replace($(_Manifest), '(?m)^version:.*$', 'version: $(RhinoAIPackageVersion)'))</_Manifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(YakStagingDir)/manifest.yml" Lines="$(_Manifest)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <PropertyGroup>
    <RouterRids Condition="'$(RouterRids)' == '' AND '$(PluginOS)' == 'osx'">osx-arm64</RouterRids>
    <RouterRids Condition="'$(RouterRids)' == ''">win-x64;win-arm64</RouterRids>
  </PropertyGroup>

  <!--
  -->
  <Target Name="BundleRouter" AfterTargets="Build">
    <ItemGroup>
      <_RouterRid Include="$([MSBuild]::Unescape($(RouterRids)))" />
    </ItemGroup>
    <!-- Publish one RID at a time via Exec -->
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../router" Command="dotnet publish Router.csproj --configuration $(Configuration) --runtime %(_RouterRid.Identity) -p:RhinoTarget=$(RhinoTarget) --output &quot;$(YakStagingDir)/router/%(_RouterRid.Identity)&quot; --nologo" />
    <!-- Strip debug artifacts after publish -->
    <RemoveDir Directories="@(_RouterRid->'$(YakStagingDir)/router/%(Identity)/rhino-mcp-router.dsym')" />
    <Delete Files="@(_RouterRid->'$(YakStagingDir)/router/%(Identity)/rhino-mcp-router.pdb')" />
    <Message Importance="high" Text="[Rhino AI] Bundled router RIDs: $(RouterRids)" />
  </Target>

  <!-- Bundle ASP.NET Core - yak/standalone builds only.
       Rhino's host does not load the Microsoft.AspNetCore.App shared framework (see
       netcore/dotnetstart.8.runtimeconfig.json: Microsoft.NETCore.App +
       Microsoft.WindowsDesktop.App only) and Rhino ships none of it, so a
       Package-Manager-installed plug-in has to carry its own copy. An in-box build must
       not: ~110 framework assemblies do not belong in src4/bin/<Config>/Plug-ins/RhinoAI,
       and whatever ships ASP.NET Core with Rhino should be the one copy everything binds
       to. Compiling is unaffected either way - the FrameworkReference above resolves
       against the targeting pack. -->
  <Target Name="BundleAspNetCoreFramework" AfterTargets="Build" Condition="'$(IsInRhino)' == 'false' AND '$(TargetFramework)' != ''">
    <PropertyGroup>
      <_FxDir Condition="'$(PluginOS)' == 'win'">$(PkgMicrosoft_AspNetCore_App_Runtime_win-x64)/runtimes/win-x64/lib/net8.0</_FxDir>
      <_FxDir Condition="'$(PluginOS)' == 'osx'">$(PkgMicrosoft_AspNetCore_App_Runtime_osx-arm64)/runtimes/osx-arm64/lib/net8.0</_FxDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(_FxDir)')" Text="ASP.NET Core runtime pack not found at '$(_FxDir)' (PluginOS=$(PluginOS)). Run 'dotnet restore' for this PluginOS first." />
    <ItemGroup>
      <_AspNetCoreFiles Include="$(_FxDir)/*.dll" Exclude="&#xA;          $(_FxDir)/Microsoft.AspNetCore.Authentication.BearerToken.dll;&#xA;          $(_FxDir)/Microsoft.AspNetCore.Authentication.Cookies.dll;&#xA;          $(_FxDir)/Microsoft.AspNetCore.Authentication.OAuth.dll;&#xA;          $(_FxDir)/Microsoft.AspNetCore.Components*.dll;&#xA;          $(_FxDir)/Microsoft.AspNetCore.Identity*.dll;&#xA;          $(_FxDir)/Microsoft.AspNetCore.Mvc*.dll;&#xA;          $(_FxDir)/Microsoft.AspNetCore.Razor*.dll;&#xA;          $(_FxDir)/Microsoft.AspNetCore.Server.HttpSys.dll;&#xA;          $(_FxDir)/Microsoft.AspNetCore.Server.IIS*.dll;&#xA;          $(_FxDir)/Microsoft.AspNetCore.SignalR*.dll;&#xA;          $(_FxDir)/Microsoft.AspNetCore.StaticFiles.dll;&#xA;          $(_FxDir)/Microsoft.Extensions.Identity*.dll&#xA;        " />
    </ItemGroup>
    <Copy SourceFiles="@(_AspNetCoreFiles)" DestinationFolder="$(YakStagingDir)/net8.0/" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[Rhino MCP] Bundled ASP.NET Core ($(PluginOS)) from $(_FxDir)" />
  </Target>

</Project>
